<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background">

    <!-- SCROLLABLE CONTENT -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/mainScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingBottom="84dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ========================================================= -->
            <!-- 1. PATRIOTIC HEADER SECTION                               -->
            <!-- ========================================================= -->
            <FrameLayout
                android:id="@+id/headerContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_header_gradient">

                <!-- Dark navy gradient & Statue of Liberty / Capitol Artwork Overlay -->
                <ImageView
                    android:id="@+id/ivHeaderArtwork"
                    android:layout_width="match_parent"
                    android:layout_height="250dp"
                    android:contentDescription="@string/content_desc_header_art"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_header_patriotic" />

                <!-- Deep Blue Vignette / Gradient scrim for high contrast typography -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="250dp"
                    android:background="#99061226" />

                <!-- Header Foreground Content -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingTop="36dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="24dp">

                    <!-- Hamburger Menu Button -->
                    <ImageButton
                        android:id="@+id/btnMenu"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/content_desc_menu"
                        android:padding="12dp"
                        android:src="@drawable/ic_menu"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/white" />

                    <!-- Golden Stars Decoration in Top Center -->
                    <ImageView
                        android:id="@+id/ivGoldenStars"
                        android:layout_width="120dp"
                        android:layout_height="28dp"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_golden_stars"
                        app:layout_constraintBottom_toBottomOf="@id/btnMenu"
                        app:layout_constraintEnd_toStartOf="@id/btnNotifications"
                        app:layout_constraintStart_toEndOf="@id/btnMenu"
                        app:layout_constraintTop_toTopOf="@id/btnMenu" />

                    <!-- Notifications Bell Button -->
                    <ImageButton
                        android:id="@+id/btnNotifications"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/content_desc_notifications"
                        android:padding="12dp"
                        android:src="@drawable/ic_notifications"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- Main App Title: "US Citizenship" -->
                    <TextView
                        android:id="@+id/tvHeaderTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:letterSpacing="0.03"
                        android:shadowColor="#80000000"
                        android:shadowDx="0"
                        android:shadowDy="3"
                        android:shadowRadius="6"
                        android:text="@string/header_title"
                        android:textColor="@color/white"
                        android:textSize="30sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/btnMenu" />

                    <!-- Red Ribbon with White Text: "TEST PREP" -->
                    <LinearLayout
                        android:id="@+id/ribbonContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_red_ribbon"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingStart="22dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="22dp"
                        android:paddingBottom="5dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvHeaderTitle">

                        <TextView
                            android:id="@+id/tvHeaderRibbon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:letterSpacing="0.12"
                            android:text="@string/header_ribbon_text"
                            android:textColor="@color/white"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- Subtitle: "Civics • Interview • Practice" -->
                    <TextView
                        android:id="@+id/tvHeaderSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.05"
                        android:shadowColor="#99000000"
                        android:shadowDx="0"
                        android:shadowDy="2"
                        android:shadowRadius="4"
                        android:text="@string/header_subtitle"
                        android:textColor="@color/text_gold"
                        android:textSize="13sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/ribbonContainer" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Flowing American Flag Ribbon Wave Separator at bottom of Header -->
                <ImageView
                    android:id="@+id/ivHeaderFlagWave"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_gravity="bottom"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_flag_wave" />
            </FrameLayout>

            <!-- ========================================================= -->
            <!-- BODY CONTENT CONTAINER                                    -->
            <!-- ========================================================= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp">

                <!-- ========================================================= -->
                <!-- 2. CIVICS TEST VERSION SELECTOR                          -->
                <!-- ========================================================= -->
                <LinearLayout
                    android:id="@+id/versionSelectorContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <!-- Button 1: 2025 Civics Test (Selected by default) -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnTest2025"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="@color/navy_selected"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="2dp"
                        app:strokeColor="#1A3B73"
                        app:strokeWidth="1.5dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="12dp"
                            android:paddingTop="12dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="12dp">

                            <ImageView
                                android:id="@+id/ivCheck2025"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_check_circle" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvTitle2025"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:fontFamily="sans-serif-bold"
                                    android:maxLines="1"
                                    android:text="@string/version_2025_title"
                                    android:textColor="@color/white"
                                    android:textSize="13sp" />
                            </LinearLayout>

                            <!-- NEW Badge -->
                            <TextView
                                android:id="@+id/tvBadge2025"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_badge_new"
                                android:fontFamily="sans-serif-black"
                                android:letterSpacing="0.05"
                                android:text="@string/version_2025_badge"
                                android:textColor="@color/white"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Button 2: 2008 Civics Test (Unselected by default) -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnTest2008"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="@color/selector_unselected_bg"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#D0DFEE"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="12dp"
                            android:paddingTop="12dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="12dp">

                            <ImageView
                                android:id="@+id/ivCheck2008"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_circle_outline" />

                            <TextView
                                android:id="@+id/tvTitle2008"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:fontFamily="sans-serif-medium"
                                android:maxLines="1"
                                android:text="@string/version_2008_title"
                                android:textColor="@color/selector_unselected_text"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <!-- ========================================================= -->
                <!-- 3. SIX MAIN FEATURE CARDS (2-Column Grid)                 -->
                <!-- ========================================================= -->

                <!-- ROW 1: Study Questions & Practice Test -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <!-- CARD 1: Study Questions -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardStudyQuestions"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="@color/card_study_bg"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="2dp"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <ImageView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_book_flag" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:fontFamily="sans-serif-bold"
                                android:text="@string/card_study_title"
                                android:textColor="@color/text_primary"
                                android:textSize="16sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="sans-serif"
                                android:lineSpacingExtra="2dp"
                                android:text="@string/card_study_subtitle"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- CARD 2: Practice Test -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardPracticeTest"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="@color/card_practice_bg"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="2dp"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <ImageView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_quiz_pencil" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:fontFamily="sans-serif-bold"
                                android:text="@string/card_practice_title"
                                android:textColor="@color/text_primary"
                                android:textSize="16sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="sans-serif"
                                android:lineSpacingExtra="2dp"
                                android:text="@string/card_practice_subtitle"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <!-- ROW 2: Flashcards & Interview Prep -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <!-- CARD 3: Flashcards -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardFlashcards"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="@color/card_flashcards_bg"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="2dp"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <ImageView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_flashcards" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:fontFamily="sans-serif-bold"
                                android:text="@string/card_flashcards_title"
                                android:textColor="@color/text_primary"
                                android:textSize="16sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="sans-serif"
                                android:lineSpacingExtra="2dp"
                                android:text="@string/card_flashcards_subtitle"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- CARD 4: Interview Prep -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardInterviewPrep"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="@color/card_interview_bg"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="2dp"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <ImageView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_interview_chat" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:fontFamily="sans-serif-bold"
                                android:text="@string/card_interview_title"
                                android:textColor="@color/text_primary"
                                android:textSize="16sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="sans-serif"
                                android:lineSpacingExtra="2dp"
                                android:text="@string/card_interview_subtitle"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <!-- ROW 3: My Progress & Saved Questions -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <!-- CARD 5: My Progress -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardMyProgress"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="@color/card_progress_bg"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="2dp"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <ImageView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_chart_growth" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:fontFamily="sans-serif-bold"
                                android:text="@string/card_my_progress_title"
                                android:textColor="@color/text_primary"
                                android:textSize="16sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="sans-serif"
                                android:lineSpacingExtra="2dp"
                                android:text="@string/card_my_progress_subtitle"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- CARD 6: Saved Questions -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardSavedQuestions"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="@color/card_saved_bg"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="2dp"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <ImageView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_bookmark_star" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:fontFamily="sans-serif-bold"
                                android:text="@string/card_saved_title"
                                android:textColor="@color/text_primary"
                                android:textSize="16sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="sans-serif"
                                android:lineSpacingExtra="2dp"
                                android:text="@string/card_saved_subtitle"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <!-- ========================================================= -->
                <!-- 4. STUDY PROGRESS SECTION                                 -->
                <!-- ========================================================= -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardStudyProgressContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/card_surface_white"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#E2E8F0"
                    app:strokeWidth="1dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <!-- Circular Progress Container with Centered % Text -->
                        <FrameLayout
                            android:id="@+id/circularProgressFrame"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:id="@+id/progressCircular"
                                android:layout_width="64dp"
                                android:layout_height="64dp"
                                android:layout_gravity="center"
                                android:max="100"
                                android:progress="72"
                                app:indicatorColor="@color/navy_primary"
                                app:indicatorSize="60dp"
                                app:trackColor="@color/progress_track"
                                app:trackCornerRadius="4dp"
                                app:trackThickness="6dp" />

                            <TextView
                                android:id="@+id/tvProgressPercent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:fontFamily="sans-serif-black"
                                android:text="@string/progress_percent_sample"
                                android:textColor="@color/navy_primary"
                                android:textSize="15sp" />
                        </FrameLayout>

                        <!-- Progress Text & Horizontal Bar Details -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_marginEnd="8dp"
                            android:orientation="vertical"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/btnProgressDetails"
                            app:layout_constraintStart_toEndOf="@id/circularProgressFrame"
                            app:layout_constraintTop_toTopOf="parent">

                            <TextView
                                android:id="@+id/tvProgressTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-bold"
                                android:text="@string/progress_card_title"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp" />

                            <TextView
                                android:id="@+id/tvMasteredQuestions"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:fontFamily="sans-serif"
                                android:text="@string/progress_mastered_sample"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />

                            <!-- Horizontal Progress Indicator -->
                            <com.google.android.material.progressindicator.LinearProgressIndicator
                                android:id="@+id/progressHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:max="100"
                                android:progress="72"
                                app:indicatorColor="@color/navy_primary"
                                app:trackColor="@color/progress_track"
                                app:trackCornerRadius="4dp"
                                app:trackThickness="8dp" />
                        </LinearLayout>

                        <!-- Right-facing Navigation Arrow -->
                        <ImageButton
                            android:id="@+id/btnProgressDetails"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/content_desc_progress_details"
                            android:src="@drawable/ic_chevron_right"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:tint="@color/text_secondary" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ============================================================= -->
    <!-- 5. FIXED BOTTOM NAVIGATION                                    -->
    <!-- ============================================================= -->
    <FrameLayout
        android:id="@+id/bottomNavContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_nav"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Decorative American Flag Wave Watermark Behind Navigation Items -->
        <ImageView
            android:id="@+id/ivBottomNavFlagWave"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:alpha="0.08"
            android:clickable="false"
            android:contentDescription="@null"
            android:focusable="false"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/img_flag_wave" />

        <!-- 5 Navigation Bar Items -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Item 1: Home (Selected by default) -->
            <LinearLayout
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivNavHome"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/nav_home"
                    android:src="@drawable/nav_home"
                    app:tint="@color/nav_active" />

                <TextView
                    android:id="@+id/tvNavHome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="@string/nav_home"
                    android:textColor="@color/nav_active"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Item 2: Study -->
            <LinearLayout
                android:id="@+id/navStudy"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivNavStudy"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/nav_study"
                    android:src="@drawable/nav_study"
                    app:tint="@color/nav_inactive" />

                <TextView
                    android:id="@+id/tvNavStudy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/nav_study"
                    android:textColor="@color/nav_inactive"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Item 3: Practice -->
            <LinearLayout
                android:id="@+id/navPractice"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivNavPractice"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/nav_practice"
                    android:src="@drawable/nav_practice"
                    app:tint="@color/nav_inactive" />

                <TextView
                    android:id="@+id/tvNavPractice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/nav_practice"
                    android:textColor="@color/nav_inactive"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Item 4: Progress -->
            <LinearLayout
                android:id="@+id/navProgress"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivNavProgress"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/nav_progress"
                    android:src="@drawable/nav_progress"
                    app:tint="@color/nav_inactive" />

                <TextView
                    android:id="@+id/tvNavProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/nav_progress"
                    android:textColor="@color/nav_inactive"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Item 5: Settings -->
            <LinearLayout
                android:id="@+id/navSettings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivNavSettings"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/nav_settings"
                    android:src="@drawable/nav_settings"
                    app:tint="@color/nav_inactive" />

                <TextView
                    android:id="@+id/tvNavSettings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/nav_settings"
                    android:textColor="@color/nav_inactive"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
